# Captionary — Development Environment
# Copy this file to `.env.development` and fill in real values.
# This file IS committed as documentation. `.env.development` is NOT committed.
# See docs/DEVELOPMENT_GUIDE.md for usage.

# ─── Flutter App (public, safe to embed via --dart-define) ────────────────────
BACKEND_MODE=mock
R2_BASE_URL=https://pub-6315c0ddbd0d44b4856162c00e47e86e.r2.dev
MANIFEST_URL=https://pub-6315c0ddbd0d44b4856162c00e47e86e.r2.dev/manifest.json
DONATE_WEB_URL=https://captionary.brianproducedit.workers.dev/donate

# ─── R2 upload script only (NEVER enter the app) ─────────────────────────────
R2_ACCOUNT_ID=replace-with-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret
R2_BUCKET=captionary-models
R2_PUBLIC_BASE_URL=https://models.captionary.co.zw/

# ─── Public donation links ───────────────────────────────────────────────────
DONATE_KOFI_URL=https://ko-fi.com/replace
DONATE_BMAC_URL=https://buymeacoffee.com/replace
DONATE_CRYPTO_BTC_ADDRESS=replace-with-public-address
DONATE_CRYPTO_ETH_ADDRESS=replace-with-public-address
DONATE_CRYPTO_USDT_ADDRESS=replace-with-public-address

# Google AdMob Monetization (Development uses official Google test IDs)
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111
ADMOB_PUBLISHER_ID=pub-0000000000000000
