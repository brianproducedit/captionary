# Captionary public/runtime configuration.
# This file is committed as documentation and contains placeholders only.
# Never commit .env. Do not bundle upload credentials into Flutter or React.

# Public model catalog configuration used by the app.
R2_BASE_URL=https://models.example.com/
MANIFEST_URL=https://models.example.com/manifest.json
DONATE_WEB_URL=https://captionary.example/donate
APP_ENV=development
BACKEND_MODE=mock

# Local R2 upload-script configuration only. Never load these into the app.
R2_ACCOUNT_ID=replace-with-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret
R2_BUCKET=captionary-models
R2_PUBLIC_BASE_URL=https://models.example.com/

# Public donation links. Payment confirmation remains external/manual.
DONATE_KOFI_URL=https://ko-fi.com/replace
DONATE_BMAC_URL=https://buymeacoffee.com/replace
DONATE_CRYPTO_BTC_ADDRESS=replace-with-public-address
DONATE_CRYPTO_ETH_ADDRESS=replace-with-public-address
DONATE_CRYPTO_USDT_ADDRESS=replace-with-public-address

# Google AdMob Monetization (Keep real production IDs secret in .env)
# AdMob App ID (format: ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY)
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
# AdMob Banner Ad Unit ID (format: ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ)
ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111
# AdMob Publisher ID (for app-ads.txt: pub-XXXXXXXXXXXXXXXX)
ADMOB_PUBLISHER_ID=pub-0000000000000000
